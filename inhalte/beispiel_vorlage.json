   {
    "lernziel": "subtrahieren",
    "titel": "Ganze Zahlen subtrahieren",
    "regel": "Eine Zahl subtrahieren heißt ihre ⟦Gegenzahl addieren⟧: a − (−b) = a + b.",
    "schritte": [
     "5 − (−3) wird zu 5 + 3.",
     "5 + 3 = ⟦8⟧."
    ],
    "probe": "8 + (−3) = 5 ✓",
    "fehler": "5 − (−3) = 2 ist falsch: Minus mal Minus wird ⟦Plus⟧."
